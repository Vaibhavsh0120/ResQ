{
  "expo": {
    "name": "ResQ",
    "slug": "resq",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "resq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.resq.app",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.resq.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "imageWidth": 120,
            "resizeMode": "contain",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ResQ uses your location to show nearby safe places and emergency services."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ResQ uses your photos to attach evidence to incident reports.",
          "cameraPermission": "ResQ uses your camera to attach a photo of what you're seeing to an incident report."
        }
      ],
      "expo-notifications",
      "expo-video",
      "expo-secure-store",
      "expo-dev-client",
      "@maplibre/maplibre-react-native",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "ResQ uses your microphone so you can talk to ResQ instead of typing.",
          "speechRecognitionPermission": "ResQ uses speech recognition to turn what you say into text for ResQ to respond to."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
