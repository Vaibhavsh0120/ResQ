# Copy this file to .env and fill in values for your environment.
# Expo only exposes env vars prefixed with EXPO_PUBLIC_ to app code.
# See: https://docs.expo.dev/guides/environment-variables/

# Base URL of the ResQ backend / RAG API. Leave unset to run entirely on
# local mock data (see src/config/env.ts and src/data/).
# Example: EXPO_PUBLIC_API_BASE_URL=https://api.resq.app
EXPO_PUBLIC_API_BASE_URL=

# Force mock data even if EXPO_PUBLIC_API_BASE_URL is set (useful for UI
# development against a backend that isn't ready yet). Defaults to false.
EXPO_PUBLIC_USE_MOCK_DATA=false
